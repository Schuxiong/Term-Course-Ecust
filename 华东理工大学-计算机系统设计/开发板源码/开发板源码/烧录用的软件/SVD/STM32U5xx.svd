						</field>
						<field>
							<name>EPDM</name>
							<description>EPDM</description>
							<bitOffset>1</bitOffset>
							<bitWidth>1</bitWidth>
						</field>
						<field>
							<name>TOM</name>
							<description>TOM</description>
							<bitOffset>3</bitOffset>
							<bitWidth>1</bitWidth>
