						</field>
						<field>
							<name>PTCTL</name>
							<description>PTCTL</description>
							<bitOffset>13</bitOffset>
							<bitWidth>4</bitWidth>
							<access>read-write</access>
						</field>
						<field>
							<name>PSPD</name>
							<description>PSPD</description>
							<bitOffset>17</bitOffset>
							<bitWidth>2</bitWidth>
							<access>read-only</access>
						</field>
					</fields>
				</register>
