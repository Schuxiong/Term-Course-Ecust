        <description>MDF1 filter 3 global interrupt</description>
        <value>105</value>
      </interrupt>
	  <interrupt>
        <name>MDF1_FLT4</name>
        <description>MDF1 filter 4 global interrupt</description>
        <value>121</value>
      </interrupt>
	  <interrupt>
